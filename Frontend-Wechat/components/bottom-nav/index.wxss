.bottom-nav-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  height: calc(128rpx + env(safe-area-inset-bottom));
  overflow: visible;
}

.bottom-nav-card {
  position: absolute;
  left: 0;
  right: 0;
  bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  box-sizing: border-box;
  height: 128rpx;
  padding: 12rpx 15rpx 0;
  border-radius: 46rpx 46rpx 62rpx 62rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 2rpx solid #DDEBFF;
  backdrop-filter: blur(48rpx);
  -webkit-backdrop-filter: blur(48rpx);
  box-shadow: 0 20rpx 56rpx rgba(142, 163, 255, 0.18);
}

.bottom-nav-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 123rpx;
  height: 88rpx;
  border-radius: 43rpx;
}

.bottom-nav-active-bg {
  position: absolute;
  top: 0;
  left: 50%;
  width: 152rpx;
  height: 88rpx;
  border-radius: 43rpx;
  background:
    linear-gradient(112deg, rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0.42)),
    linear-gradient(112deg, rgba(95, 211, 220, 0.52), rgba(246, 166, 221, 0.52) 55%, rgba(158, 140, 255, 0.52));
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  box-shadow:
    0 2rpx 16rpx rgba(255, 255, 255, 0.4),
    0 16rpx 36rpx rgba(165, 140, 255, 0.18);
  transform: translateX(-50%);
}

.bottom-nav-active-shine {
  position: absolute;
  top: 12rpx;
  left: 20rpx;
  width: 112rpx;
  height: 23rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, rgba(255, 255, 255, 0.72), rgba(255, 255, 255, 0.1));
}

.bottom-nav-label {
  position: relative;
  z-index: 1;
  color: #8E7F8B;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 50rpx;
}

.bottom-nav-item-active .bottom-nav-label {
  color: #20151D;
  font-weight: 800;
}

.bottom-nav-pressed {
  transform: scale(0.96);
}
