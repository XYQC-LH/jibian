.bottom-nav-shell {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  height: calc(128rpx + env(safe-area-inset-bottom));
  overflow: visible;
}

.bottom-nav-glow {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  bottom: env(safe-area-inset-bottom);
  height: 128rpx;
  border-radius: 62rpx;
  background: linear-gradient(180deg, rgba(250, 246, 255, 0.55), rgba(223, 210, 255, 0.2));
  box-shadow:
    0 0 28rpx rgba(175, 82, 222, 0.32),
    0 -8rpx 34rpx rgba(158, 140, 255, 0.28),
    0 12rpx 30rpx rgba(175, 82, 222, 0.18);
}

.bottom-nav-card {
  position: absolute;
  left: 0;
  right: 0;
  bottom: env(safe-area-inset-bottom);
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  box-sizing: border-box;
  height: 128rpx;
  padding: 12rpx 15rpx 0;
  border-radius: 62rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9),
    inset 0 -2rpx 0 rgba(226, 214, 255, 0.55);
}

.bottom-nav-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 123rpx;
  height: 88rpx;
  border-radius: 43rpx;
}

.bottom-nav-active-bg {
  position: absolute;
  top: 0;
  left: 50%;
  width: 152rpx;
  height: 88rpx;
  border-radius: 43rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #F9F3FF 52%, #F8EAF4 100%);
  box-shadow:
    0 11rpx 22rpx rgba(175, 82, 222, 0.14),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.96);
  transform: translateX(-50%);
}

.bottom-nav-active-shine {
  position: absolute;
  top: 12rpx;
  left: 17rpx;
  width: 112rpx;
  height: 23rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(175, 82, 222, 0.16), rgba(246, 166, 221, 0.18));
}

.bottom-nav-label {
  position: relative;
  z-index: 1;
  color: #85828E;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 50rpx;
}

.bottom-nav-item-active .bottom-nav-label {
  color: var(--text-primary);
}

.bottom-nav-pressed {
  transform: scale(0.96);
}
