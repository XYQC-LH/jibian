.result-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #FFFFFF;
  font-family: -apple-system, BlinkMacSystemFont, "Noto Sans SC", "Source Han Sans SC", sans-serif;
}

.result-preview {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 1110rpx;
  background: #ECECF1;
}

.preview-fade {
  position: absolute;
  left: 0;
  right: 0;
  top: 686rpx;
  height: 300rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, #FFFFFF 78%);
}

.top-bar {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  height: 76rpx;
  padding: 0 24rpx;
}

.page-title {
  color: var(--text-primary);
  font-size: 34rpx;
  font-weight: 900;
}

.success-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 52rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  color: #34A853;
  background: rgba(255, 255, 255, 0.88);
  font-size: 23rpx;
  font-weight: 900;
}

.result-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 123rpx;
  z-index: 3;
  box-sizing: border-box;
  padding: 16rpx 24rpx 24rpx;
  border-radius: 34rpx 34rpx 0 0;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -18rpx 48rpx rgba(88, 86, 214, 0.14);
}

.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #D7D7DE;
}

.sheet-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.result-title,
.result-copy {
  display: block;
}

.result-title {
  color: var(--text-primary);
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.25;
}

.result-copy {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 23rpx;
  line-height: 1.42;
}

.result-price {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: var(--accent-primary);
  background: var(--accent-soft);
  font-size: 22rpx;
  font-weight: 900;
}

.source-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
  box-sizing: border-box;
  padding: 14rpx;
  border-radius: 24rpx;
  background: #F5F5FA;
}

.source-thumb {
  width: 86rpx;
  height: 86rpx;
  border-radius: 18rpx;
  background: #ECECF1;
}

.source-copy {
  flex: 1;
  min-width: 0;
}

.source-title,
.source-desc {
  display: block;
}

.source-title {
  color: var(--text-primary);
  font-size: 25rpx;
  font-weight: 900;
}

.source-desc {
  margin-top: 7rpx;
  color: var(--text-tertiary);
  font-size: 21rpx;
}

.scene-row {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.scene-row text {
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  color: #7B7B84;
  background: var(--bg-surface);
  font-size: 21rpx;
  font-weight: 800;
}

.save-strip {
  margin-top: 22rpx;
  box-sizing: border-box;
  padding: 18rpx;
  border-radius: 28rpx;
  background: #F6F1FA;
}

.save-copy {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.save-title,
.save-subtitle {
  display: block;
}

.save-title {
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 900;
}

.save-subtitle {
  color: var(--text-tertiary);
  font-size: 21rpx;
  font-weight: 700;
}

.capsule-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.capsule-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  box-sizing: border-box;
  height: 62rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: var(--text-primary);
  background: #FFFFFF;
  font-size: 23rpx;
  font-weight: 900;
  line-height: 62rpx;
}

.capsule-primary {
  color: #FFFFFF;
  background: var(--accent-gradient);
}

.share-action {
  border: 0;
}

.share-action::after {
  border: 0;
}

.text-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  margin-top: 12rpx;
  color: var(--accent-primary);
  font-size: 25rpx;
  font-weight: 900;
}
