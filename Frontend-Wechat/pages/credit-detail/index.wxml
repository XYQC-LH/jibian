<view class="detail-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="detail-nav">
    <view class="back-button" bindtap="goBack" hover-class="button-pressed">‹</view>
    <text class="detail-title">充值明细</text>
  </view>

  <view class="summary-card">
    <text class="summary-label">当前积分</text>
    <text class="summary-value">{{totalCredits}}</text>
    <text class="summary-copy">明细来自后端积分流水，生成失败会自动返还</text>
  </view>

  <view class="detail-tabs">
    <view class="detail-tab detail-tab-active">积分明细</view>
  </view>

  <view class="record-list">
    <view class="empty-row" wx:if="{{!records.length}}">暂无积分流水</view>
    <block wx:for="{{records}}" wx:key="time">
      <view class="record-row">
        <view>
          <text class="record-title">{{item.title}}</text>
          <text class="record-time">{{item.time}}</text>
        </view>
        <view class="record-right">
          <text class="record-amount {{item.failed ? 'record-amount-muted' : ''}}">{{item.amount}}</text>
          <text class="record-status {{item.failed ? 'record-status-failed' : ''}}">{{item.status}}</text>
        </view>
      </view>
    </block>
  </view>
</view>
