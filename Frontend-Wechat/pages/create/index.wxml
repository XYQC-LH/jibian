<view class="create-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="create-atmosphere">
    <image class="create-atmosphere-image" src="/assets/design/hero-bg.png" mode="aspectFill" />
    <view class="create-atmosphere-gradient"></view>
  </view>

  <view class="template-nav-shell">
    <scroll-view class="template-nav" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="template-nav-track">
        <block wx:for="{{templateNavItems}}" wx:key="id">
          <view
            class="template-nav-pill {{selectedTemplateId === item.id ? 'template-nav-pill-active' : ''}}"
            bindtap="selectTemplate"
            data-id="{{item.id}}"
            hover-class="button-pressed"
          >
            {{item.label}}
          </view>
        </block>
      </view>
    </scroll-view>
  </view>

  <view class="preview-card">
    <block wx:if="{{resultReady}}">
      <image class="preview-image preview-result" src="{{resultImage}}" mode="aspectFit" bindtap="previewResult" />
    </block>
    <block wx:else>
      <swiper
        class="preview-swiper"
        current="{{currentIndex}}"
        bindchange="onPreviewChange"
        circular="{{false}}"
        duration="250"
      >
        <block wx:for="{{previewTemplates}}" wx:key="id">
          <swiper-item>
            <image class="preview-image" src="{{item.cover}}" mode="aspectFit" />
          </swiper-item>
        </block>
      </swiper>
      <view class="preview-fade"></view>
      <text class="preview-title">{{previewTitle}}</text>
      <button class="preview-share" open-type="share" hover-class="button-pressed">
        <image class="preview-share-icon" src="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20width='20'%20height='20'%20viewBox='0%200%2024%2024'%20fill='none'%20stroke='%23FFFFFF'%20stroke-width='2.2'%20stroke-linecap='round'%20stroke-linejoin='round'%3E%3Cpath%20d='M4%2012v8a2%202%200%200%200%202%202h12a2%202%200%200%200%202-2v-8'/%3E%3Cpolyline%20points='16%206%2012%202%208%206'/%3E%3Cline%20x1='12'%20x2='12'%20y1='2'%20y2='15'/%3E%3C/svg%3E" mode="aspectFit" />
      </button>
    </block>
    <view class="preview-generating" wx:if="{{generating}}">
      <text class="generating-title">正在变化中...</text>
      <text class="generating-copy">正在生成可保存的人物图</text>
      <view class="generating-track">
        <view class="generating-bar" style="width: {{progress}}%;"></view>
      </view>
      <text class="generating-percent">{{progress}}%</text>
    </view>
  </view>

  <view class="action-panel" wx:if="{{resultReady}}">
    <view class="panel-handle"></view>
    <view class="result-head">
      <text class="result-title">{{previewTitle}}</text>
      <text class="result-copy">变好了，保存或分享给朋友吧</text>
    </view>
    <view class="result-actions">
      <view class="result-action" bindtap="generateAgain" hover-class="button-pressed">
        <text class="result-action-icon">↻</text>
        <text class="result-action-label">再变一次</text>
      </view>
      <view class="result-action" bindtap="downloadResult" hover-class="button-pressed">
        <text class="result-action-icon">⇩</text>
        <text class="result-action-label">下载</text>
      </view>
      <button class="result-action" open-type="share" hover-class="button-pressed">
        <text class="result-action-icon">↗</text>
        <text class="result-action-label">分享</text>
      </button>
    </view>
  </view>

  <view class="action-panel" wx:else>
    <view class="panel-head">
      <text class="panel-title">你的照片</text>
      <view class="change-template" bindtap="openTemplatePicker" hover-class="button-pressed">换模板</view>
    </view>

    <view class="asset-row">
      <view class="photo-slot" bindtap="chooseImage" hover-class="button-pressed">
        <image wx:if="{{imagePath}}" class="photo-slot-image" src="{{imagePath}}" mode="aspectFill" />
        <view wx:else class="photo-empty">
          <text class="upload-mark">⇧</text>
          <text class="upload-copy">去上传</text>
        </view>
      </view>
      <view wx:if="{{imagePath}}" class="remove-photo" catchtap="removeImage">×</view>
    </view>

    <text class="ratio-title">想要变成的比例</text>
    <scroll-view class="ratio-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="ratio-track">
        <block wx:for="{{ratios}}" wx:key="*this">
          <view
            class="ratio-chip {{selectedRatio === item ? 'ratio-chip-active' : ''}}"
            bindtap="selectRatio"
            data-ratio="{{item}}"
            hover-class="button-pressed"
          >
            {{item}}
          </view>
        </block>
      </view>
    </scroll-view>

    <view
      class="primary-action {{generating ? 'primary-action-disabled' : ''}}"
      bindtap="startGenerate"
      hover-class="button-pressed"
    >
      <block wx:if="{{generating}}">正在变...</block>
      <block wx:else>马上开变</block>
    </view>
  </view>
</view>
