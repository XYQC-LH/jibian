.create-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow-x: hidden;
  padding: 16rpx 0 0;
  background: #FFFFFF;
  font-family: -apple-system, BlinkMacSystemFont, "Noto Sans SC", "Source Han Sans SC", sans-serif;
}

.create-atmosphere {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 520rpx;
  background:
    linear-gradient(180deg, rgba(95, 211, 220, 0.16) 0%, rgba(246, 166, 221, 0.11) 42%, rgba(255, 255, 255, 0) 100%),
    linear-gradient(135deg, rgba(243, 250, 255, 0.92), rgba(253, 242, 255, 0.68));
  pointer-events: none;
}

.template-nav-shell {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  width: 732rpx;
  height: 68rpx;
  margin: 0 24rpx;
  overflow: hidden;
  border: 2rpx solid rgba(221, 235, 255, 0.9);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 12rpx 28rpx rgba(165, 140, 255, 0.12);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.template-nav {
  width: 100%;
  height: 72rpx;
  white-space: nowrap;
}

.template-nav-track {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  height: 72rpx;
  padding: 0 170rpx 0 12rpx;
}

.template-nav-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 73rpx;
  height: 56rpx;
  padding: 0 21rpx;
  border: 2rpx solid rgba(221, 235, 255, 0.86);
  border-radius: 999rpx;
  color: #8E7F8B;
  background: rgba(255, 255, 255, 0.78);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.03);
  font-size: 23rpx;
  font-weight: 700;
}

.template-nav-pill-active {
  min-width: 144rpx;
  border-color: rgba(255, 255, 255, 0.7);
  color: #FFFFFF;
  background: linear-gradient(90deg, #FF77B9 0%, #A58CFF 100%);
  box-shadow: 0 10rpx 20rpx rgba(165, 140, 255, 0.22);
  font-weight: 900;
}

.preview-card {
  position: relative;
  z-index: 1;
  width: 716rpx;
  height: 798rpx;
  margin: 30rpx 32rpx 0;
  overflow: hidden;
  border-radius: 36rpx;
  background: #EDEDF2;
  box-shadow: 0 10rpx 24rpx rgba(142, 163, 255, 0.12);
}

.preview-image {
  display: block;
  width: 100%;
  height: 100%;
}

.preview-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 246rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.58) 100%);
}

.preview-title {
  position: absolute;
  left: 36rpx;
  bottom: 34rpx;
  max-width: 450rpx;
  overflow: hidden;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 900;
  line-height: 38rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-share {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  margin: 0;
  padding: 0;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: rgba(0, 0, 0, 0.28);
  font-size: 27rpx;
  line-height: 48rpx;
}

.preview-share::after {
  border: 0;
}

.preview-generating {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(244, 244, 246, 0.82);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.generating-title,
.generating-copy,
.generating-percent {
  display: block;
}

.generating-title {
  color: #20151D;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.generating-copy {
  margin-top: 10rpx;
  color: #8E7F8B;
  font-size: 22rpx;
  line-height: 31rpx;
}

.generating-track {
  width: 160rpx;
  height: 6rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #EFEAF8;
}

.generating-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #A58CFF 0%, #FF77B9 100%);
  transition: width 180ms ease-out;
}

.generating-percent {
  margin-top: 12rpx;
  color: #AF52DE;
  font-size: 22rpx;
  font-weight: 900;
}

.action-panel {
  position: absolute;
  left: 0;
  right: 0;
  top: 990rpx;
  z-index: 2;
  box-sizing: border-box;
  height: 578rpx;
  margin: 0;
  padding: 20rpx 26rpx 0;
  border-radius: 40rpx 40rpx 0 0;
  background: #FFFFFF;
  box-shadow: 0 -10rpx 30rpx rgba(165, 140, 255, 0.08);
}

.panel-handle {
  width: 115rpx;
  height: 10rpx;
  margin: 0 auto 18rpx;
  border-radius: 999rpx;
  background: #E8E8EF;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44rpx;
}

.panel-title,
.ratio-title {
  display: block;
  color: #20151D;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.change-template {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 80rpx;
  margin-top: -24rpx;
  border-radius: 0 0 26rpx 26rpx;
  color: #FFFFFF;
  background: linear-gradient(90deg, #FF77B9 0%, #A58CFF 100%);
  box-shadow: 0 10rpx 22rpx rgba(165, 140, 255, 0.24);
  font-size: 22rpx;
  font-weight: 900;
}

.asset-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 0 0;
}

.photo-slot {
  position: relative;
  width: 156rpx;
  height: 156rpx;
  overflow: visible;
}

.photo-slot-image,
.photo-empty {
  width: 140rpx;
  height: 140rpx;
  margin: 8rpx;
  border-radius: 26rpx;
}

.photo-slot-image {
  display: block;
  background: #EDEDF2;
}

.photo-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx dashed #D9C7FF;
  color: #AF52DE;
  background: #F7F3FF;
}

.upload-mark,
.upload-copy {
  display: block;
}

.upload-mark {
  font-size: 31rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.upload-copy {
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.remove-photo {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border: 3rpx solid #FFFFFF;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: #20151D;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 34rpx;
}

.template-mini {
  position: relative;
  width: 192rpx;
  height: 152rpx;
  overflow: hidden;
  border-radius: 28rpx;
  background: #EDEDF2;
}

.template-mini-image {
  display: block;
  width: 100%;
  height: 100%;
}

.template-mini-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 65rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.56) 100%);
}

.template-mini-name {
  position: absolute;
  left: 15rpx;
  right: 15rpx;
  bottom: 13rpx;
  overflow: hidden;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 31rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ratio-title {
  margin: 28rpx 0 14rpx;
}

.ratio-scroll {
  width: 100%;
  height: 60rpx;
  white-space: nowrap;
}

.ratio-track {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  height: 60rpx;
  padding: 0 14rpx;
}

.ratio-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 60rpx;
  border-radius: 999rpx;
  color: #8E7F8B;
  background: #F3F3F6;
  font-size: 22rpx;
  font-weight: 800;
}

.ratio-chip-active {
  color: #AF52DE;
  background: #F4ECFD;
  box-shadow: inset 0 0 0 2rpx rgba(175, 82, 222, 0.16);
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 92rpx;
  margin: 32rpx 22rpx 0;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: linear-gradient(90deg, #A58CFF 0%, #FF77B9 100%);
  box-shadow: 0 12rpx 26rpx rgba(246, 166, 221, 0.26);
  font-size: 27rpx;
  font-weight: 900;
}

.primary-action-disabled {
  color: #8E7F8B;
  background: #EDEDF2;
  box-shadow: none;
}
