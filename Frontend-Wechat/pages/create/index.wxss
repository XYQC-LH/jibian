.create-page {
  position: relative;
  min-height: 100vh;
  box-sizing: border-box;
  overflow-x: hidden;
  padding: 16rpx 0 0;
  background: #FFFFFF;
  font-family: -apple-system, BlinkMacSystemFont, "Noto Sans SC", "Source Han Sans SC", sans-serif;
}

.create-atmosphere {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 692rpx;
  overflow: hidden;
  pointer-events: none;
}

.create-atmosphere-image,
.create-atmosphere-gradient {
  position: absolute;
  top: 0;
  left: 0;
  width: 750rpx;
}

.create-atmosphere-image {
  height: 500rpx;
  opacity: 0.28;
}

.create-atmosphere-gradient {
  height: 692rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0) 0%, rgba(244, 236, 253, 0.8) 58%, #FFFFFF 100%);
}

.template-nav-shell {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  width: 485rpx;
  height: 85rpx;
  margin: 0;
  overflow: hidden;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.72);
  box-shadow: 0 8rpx 20rpx rgba(142, 163, 255, 0.07);
  backdrop-filter: blur(18rpx);
  -webkit-backdrop-filter: blur(18rpx);
}

.template-nav {
  width: 100%;
  height: 85rpx;
  white-space: nowrap;
}

.template-nav-track {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  height: 85rpx;
  padding: 6rpx 19rpx;
}

.template-nav-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 98rpx;
  height: 54rpx;
  padding: 0 24rpx;
  border: 2rpx solid #DDEBFF;
  border-radius: 999rpx;
  color: #8E7F8B;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  font-size: 24rpx;
  font-weight: 700;
}

.template-nav-pill-active {
  min-width: 146rpx;
  height: 58rpx;
  border-color: rgba(255, 255, 255, 0.65);
  color: #FFFFFF;
  background: linear-gradient(130deg, #A58CFF 0%, #C7A8FF 55%, #FF9AD5 100%);
  box-shadow: 0 10rpx 24rpx rgba(165, 140, 255, 0.24);
  font-weight: 800;
}

.preview-card {
  position: relative;
  z-index: 1;
  width: 688rpx;
  height: 767rpx;
  margin: 30rpx 31rpx 0;
  overflow: hidden;
  border-radius: 54rpx;
  background: #EDEDF2;
  box-shadow: 0 15rpx 42rpx rgba(0, 0, 0, 0.10);
}

.preview-image {
  display: block;
  width: 100%;
  height: 100%;
}

.preview-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 246rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 0%, rgba(0, 0, 0, 0.58) 100%);
}

.preview-title {
  position: absolute;
  left: 40rpx;
  bottom: 37rpx;
  max-width: 442rpx;
  overflow: hidden;
  color: #FFFFFF;
  font-size: 33rpx;
  font-weight: 700;
  line-height: 41rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-share {
  position: absolute;
  top: 46rpx;
  right: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  margin: 0;
  padding: 0;
  border-radius: 0;
  color: #FFFFFF;
  background: transparent;
  font-size: 32rpx;
  line-height: 38rpx;
}

.preview-share::after {
  border: 0;
}

.preview-share-icon {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 38rpx;
}

.preview-generating {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: rgba(244, 244, 246, 0.82);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
}

.generating-title,
.generating-copy,
.generating-percent {
  display: block;
}

.generating-title {
  color: #20151D;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 40rpx;
}

.generating-copy {
  margin-top: 10rpx;
  color: #8E7F8B;
  font-size: 22rpx;
  line-height: 31rpx;
}

.generating-track {
  width: 160rpx;
  height: 6rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #EFEAF8;
}

.generating-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #A58CFF 0%, #FF77B9 100%);
  transition: width 180ms ease-out;
}

.generating-percent {
  margin-top: 12rpx;
  color: #AF52DE;
  font-size: 22rpx;
  font-weight: 900;
}

.action-panel {
  position: absolute;
  left: 0;
  right: 0;
  top: 952rpx;
  z-index: 2;
  box-sizing: border-box;
  height: 556rpx;
  margin: 0;
  padding: 33rpx 25rpx 0;
  border-radius: 46rpx 46rpx 0 0;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(46rpx);
  -webkit-backdrop-filter: blur(46rpx);
  box-shadow: 0 -16rpx 46rpx rgba(0, 0, 0, 0.08);
}

.panel-head {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 44rpx;
}

.panel-title,
.ratio-title {
  display: block;
  color: #20151D;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 36rpx;
}

.change-template {
  position: absolute;
  top: -21rpx;
  right: -2rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 127rpx;
  height: 77rpx;
  margin-top: 0;
  border-radius: 0 0 31rpx 31rpx;
  color: #FFFFFF;
  background: linear-gradient(90deg, #FF77B9 0%, #A58CFF 100%);
  box-shadow: 0 10rpx 22rpx rgba(165, 140, 255, 0.24);
  font-size: 22rpx;
  font-weight: 900;
}

.asset-row {
  display: flex;
  align-items: flex-start;
  justify-content: flex-start;
  margin-top: 10rpx;
  padding: 0 0;
}

.photo-slot {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  overflow: visible;
  box-sizing: border-box;
  padding: 8rpx;
  border: 2rpx solid #DDEBFF;
  border-radius: 27rpx;
  background: #F3FAFF;
}

.photo-slot-image,
.photo-empty {
  width: 100%;
  height: 100%;
  border-radius: 20rpx;
}

.photo-slot-image {
  display: block;
  background: #EDEDF2;
}

.photo-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx dashed #D9C7FF;
  color: #AF52DE;
  background: #F7F3FF;
}

.upload-mark,
.upload-copy {
  display: block;
}

.upload-mark {
  font-size: 31rpx;
  font-weight: 800;
  line-height: 34rpx;
}

.upload-copy {
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 800;
  line-height: 28rpx;
}

.remove-photo {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 38rpx;
  height: 38rpx;
  border: 3rpx solid #FFFFFF;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: #20151D;
  font-size: 26rpx;
  font-weight: 900;
  line-height: 34rpx;
}

.ratio-title {
  margin: 69rpx 0 4rpx;
}

.ratio-scroll {
  width: 690rpx;
  height: 58rpx;
  margin-left: -12rpx;
  white-space: nowrap;
}

.ratio-track {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 58rpx;
  padding: 0;
}

.ratio-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 127rpx;
  height: 58rpx;
  border-radius: 999rpx;
  color: #8E7F8B;
  background: #F3F3F6;
  font-size: 22rpx;
  font-weight: 800;
}

.ratio-chip-active {
  color: #AF52DE;
  background: #F4ECFD;
  box-shadow: inset 0 0 0 2rpx rgba(175, 82, 222, 0.16);
}

.primary-action {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  margin: 32rpx 21rpx 0;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: linear-gradient(90deg, #A58CFF 0%, #FF77B9 100%);
  box-shadow: 0 12rpx 26rpx rgba(246, 166, 221, 0.26);
  font-size: 31rpx;
  font-weight: 900;
}

.primary-action-disabled {
  color: #8E7F8B;
  background: #EDEDF2;
  box-shadow: none;
}
