<view class="invite-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <view class="back-button" bindtap="goBack" hover-class="button-pressed">‹</view>
    <text class="nav-title">邀请好友</text>
  </view>

  <view class="invite-hero">
    <text class="hero-title">一起玩即变</text>
    <text class="hero-copy">好友完成首次变图后，你和好友各得 {{rewardCredits}} 积分奖励。</text>
    <view class="code-card" bindtap="copyInviteCode" hover-class="button-pressed">
      <text class="code-label">我的邀请码</text>
      <text class="code-value" wx:if="{{inviteCode}}">{{inviteCode}}</text>
      <view class="code-skeleton" wx:else></view>
    </view>
  </view>

  <view class="stats-grid">
    <view class="stat-card">
      <text class="stat-value">{{inviteCount}}</text>
      <text class="stat-label">已邀请</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{rewardedCount}}</text>
      <text class="stat-label">已奖励</text>
    </view>
    <view class="stat-card">
      <text class="stat-value">{{creditsEarned}}</text>
      <text class="stat-label">累计积分</text>
    </view>
  </view>

  <view class="bind-card" wx:if="{{canBindInviter}}">
    <text class="section-title">填写好友邀请码</text>
    <text class="bind-copy">如果你是通过好友邀请来的，也可以在首次变图前绑定邀请码。</text>
    <view class="bind-row">
      <input class="bind-input" value="{{bindCode}}" placeholder="输入好友邀请码" maxlength="16" bindinput="inputBindCode" />
      <view class="bind-button {{binding ? 'is-disabled' : ''}}" bindtap="bindInviteCode" hover-class="button-pressed">
        {{binding ? '绑定中' : '绑定'}}
      </view>
    </view>
  </view>

  <view class="step-card">
    <text class="section-title">邀请流程</text>
    <view class="step-row">
      <text class="step-index">1</text>
      <text class="step-copy">复制邀请码或分享小程序给好友</text>
    </view>
    <view class="step-row">
      <text class="step-index">2</text>
      <text class="step-copy">好友进入即变并完成首次变图</text>
    </view>
    <view class="step-row">
      <text class="step-index">3</text>
      <text class="step-copy">双方积分奖励进入账户余额</text>
    </view>
  </view>

  <button class="share-button" open-type="share" hover-class="button-pressed">分享给好友</button>
</view>
