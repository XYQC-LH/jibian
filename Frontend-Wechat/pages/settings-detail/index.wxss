.settings-detail-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 24rpx 48rpx;
  background: var(--bg-surface);
  font-family: -apple-system, BlinkMacSystemFont, "Noto Sans SC", "Source Han Sans SC", sans-serif;
}

.settings-nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
}

.back-button {
  position: absolute;
  left: 0;
  top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  color: var(--text-primary);
  font-size: 44rpx;
  font-weight: 400;
  line-height: 1;
}

.settings-title {
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 900;
}

.settings-card {
  overflow: hidden;
  margin-top: 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
}

.settings-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
}

.settings-row + .settings-row {
  border-top: 1rpx solid #F0F0F5;
}

.settings-copy {
  flex: 1;
  min-width: 0;
}

.row-title,
.row-desc,
.row-value {
  display: block;
}

.row-title {
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 900;
}

.row-desc {
  margin-top: 6rpx;
  color: var(--text-tertiary);
  font-size: 22rpx;
}

.row-value {
  margin-right: 12rpx;
  color: #9C9CA3;
  font-size: 23rpx;
  font-weight: 800;
}

.row-chevron {
  color: #C2C2C7;
  font-size: 42rpx;
  line-height: 1;
}
