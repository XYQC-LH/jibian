.gallery-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 0 180rpx;
  background: #FAFAFC;
  font-family: -apple-system, BlinkMacSystemFont, "Noto Sans SC", "Source Han Sans SC", sans-serif;
}

.gallery-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 22rpx 42rpx 0;
}

.gallery-title,
.gallery-subtitle {
  display: block;
}

.gallery-title {
  color: var(--text-primary);
  font-size: 62rpx;
  font-weight: 900;
  line-height: 1.08;
}

.gallery-subtitle {
  margin-top: 2rpx;
  color: var(--text-tertiary);
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.35;
}

.gallery-groups {
  margin-top: 28rpx;
}

.gallery-group {
  margin-top: 0;
  padding-top: 0;
}

.gallery-group + .gallery-group {
  margin-top: 8rpx;
}

.group-title {
  display: block;
  margin: 0 42rpx 4rpx;
  color: var(--text-primary);
  font-size: 40rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.gallery-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 4rpx;
  padding: 0 31rpx;
}

.gallery-image {
  display: block;
  width: calc((100% - 8rpx) / 3);
  height: 223rpx;
  background: #ECECF1;
  border-radius: 4rpx;
}

.gallery-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 962rpx;
  text-align: center;
}

.empty-icon {
  position: relative;
  width: 123rpx;
  height: 123rpx;
  border-radius: 32rpx;
  border: 5rpx solid #D1D0D5;
  box-sizing: border-box;
}

.empty-icon::before,
.empty-icon::after {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  height: 5rpx;
  border-radius: 999rpx;
  background: #D1D0D5;
  content: "";
}

.empty-icon::before {
  top: 43rpx;
}

.empty-icon::after {
  top: 67rpx;
}

.empty-title {
  margin-top: 24rpx;
  color: var(--text-primary);
  font-size: 38rpx;
  font-weight: 700;
  line-height: 56rpx;
}

.empty-copy {
  margin-top: 12rpx;
  color: var(--text-tertiary);
  font-size: 27rpx;
  font-weight: 500;
  line-height: 38rpx;
}
