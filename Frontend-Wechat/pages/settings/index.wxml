<view class="settings-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="settings-nav">
    <view class="back-button" bindtap="goBack" hover-class="button-pressed">‹</view>
    <text class="settings-title">设置</text>
  </view>

  <view class="settings-groups">
    <block wx:for="{{groups}}" wx:key="index" wx:for-item="group">
      <view class="settings-group">
        <block wx:for="{{group.rows}}" wx:key="title" wx:for-item="row">
          <view
            class="settings-row"
            bindtap="tapRow"
            data-title="{{row.title}}"
            data-type="{{row.type}}"
            hover-class="button-pressed"
          >
            <view class="settings-copy">
              <text class="row-title">{{row.title}}</text>
              <text class="row-desc">{{row.desc}}</text>
            </view>
            <block wx:if="{{row.type === 'switch'}}">
              <switch class="row-switch" checked="{{remindEnabled}}" color="#AF52DE" bindchange="toggleRemind" />
            </block>
            <block wx:else>
              <text class="row-value" wx:if="{{row.value}}">{{row.value}}</text>
              <text class="row-chevron">›</text>
            </block>
          </view>
        </block>
      </view>
    </block>
  </view>
</view>
