<view class="gallery-manage-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="manage-nav">
    <view class="close-button" bindtap="goBack" hover-class="button-pressed">×</view>
    <text class="manage-title">已选择{{selectedIds.length}}项</text>
    <view class="select-all" style="right: {{menuButtonRightGap}}px;" bindtap="toggleAll" hover-class="button-pressed">{{allSelected ? "取消" : "全选"}}</view>
  </view>

  <view class="manage-grid" wx:if="{{items.length}}">
    <block wx:for="{{items}}" wx:key="id">
      <view class="manage-card" data-id="{{item.id}}" bindtap="toggleItem" hover-class="button-pressed">
        <image class="manage-image" src="{{item.image}}" mode="aspectFill" />
        <view class="check-badge {{item.selected ? 'check-badge-active' : ''}}">{{item.selected ? "✓" : ""}}</view>
      </view>
    </block>
  </view>

  <view class="manage-empty" wx:else>
    <text class="manage-empty-title">还没有可管理的作品</text>
    <text class="manage-empty-copy">完成一次变图后再来整理图库。</text>
  </view>

  <view class="manage-actions">
    <view class="action-item" bindtap="shareSelected" hover-class="button-pressed">
      <text class="action-icon">↗</text>
      <text class="action-label">分享</text>
    </view>
    <view class="action-item" bindtap="downloadSelected" hover-class="button-pressed">
      <text class="action-icon">↓</text>
      <text class="action-label">下载</text>
    </view>
    <view class="action-item action-danger" bindtap="deleteSelected" hover-class="button-pressed">
      <text class="action-icon">×</text>
      <text class="action-label">删除</text>
    </view>
  </view>
</view>
