<view class="phone-page" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar">
    <view class="back-button" bindtap="goBack" hover-class="button-pressed">‹</view>
    <text class="nav-title">手机号绑定</text>
  </view>

  <block wx:if="{{bound}}">
    <view class="success-panel">
      <view class="success-icon">✓</view>
      <text class="success-title">绑定成功</text>
      <text class="success-copy">已绑定手机号 {{maskedPhone}}</text>
      <view class="safe-tip">用于订单通知、账号找回和积分安全提醒</view>
      <view class="finish-button" bindtap="finish" hover-class="button-pressed">完成</view>
    </view>
  </block>

  <block wx:else>
    <view class="form-panel">
      <view class="safe-tip">手机号仅用于账号安全、订单通知和注销确认。授权后由微信返回手机号，服务端不接受生产环境手工填写。</view>

      <button class="bind-button" open-type="getPhoneNumber" bindgetphonenumber="bindWechatPhone" hover-class="button-pressed">微信授权绑定</button>
    </view>
  </block>
</view>
