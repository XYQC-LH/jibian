.home-page {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  background: var(--bg-surface);
  font-family: -apple-system, BlinkMacSystemFont, "Noto Sans SC", "Source Han Sans SC", sans-serif;
}

.hero-fallback,
.hero-swiper,
.hero-slide,
.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 750rpx;
  height: 604rpx;
}

.hero-fallback {
  background: var(--hero-gradient);
}

.hero-bg {
  opacity: 0.92;
}

.hero-swiper {
  z-index: 1;
}

.hero-slide {
  overflow: hidden;
}

.hero-slide-pressed {
  opacity: 0.96;
}

.credit-pill {
  position: absolute;
  top: 17rpx;
  left: 608rpx;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  box-sizing: border-box;
  width: 127rpx;
  height: 54rpx;
  padding: 0 19rpx;
  border-radius: 999rpx;
  background: var(--bg-violet);
}

.credit-star,
.credit-value {
  color: var(--cta-violet);
  font-family: -apple-system, BlinkMacSystemFont, "Noto Sans SC", sans-serif;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1;
}

.content-sheet {
  position: absolute;
  top: 377rpx;
  left: 0;
  bottom: 0;
  z-index: 2;
  width: 750rpx;
  overflow: hidden;
  border-radius: 50rpx 50rpx 0 0;
  background: #FFFFFF;
}

.home-title {
  position: absolute;
  top: 21rpx;
  left: 31rpx;
  width: 423rpx;
  color: #000000;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 58rpx;
}

.home-scroll {
  position: absolute;
  top: 96rpx;
  left: 0;
  right: 0;
  bottom: 0;
  padding-bottom: calc(123rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.home-section {
  padding-left: 31rpx;
  margin-bottom: 10rpx;
}

.home-section-head {
  display: flex;
  align-items: center;
  height: 48rpx;
  margin-bottom: 6rpx;
}

.home-section-icon,
.home-section-title {
  line-height: 48rpx;
  white-space: nowrap;
}

.home-section-icon {
  width: 42rpx;
  height: 42rpx;
  font-size: 34rpx;
  text-align: center;
}

.home-section-icon-hot {
  color: #FF6A3D;
}

.home-section-icon-style {
  color: #8B5CF6;
}

.home-section-icon-avatar {
  color: #E84F8A;
}

.home-section-title {
  margin-left: 12rpx;
  color: var(--text-primary);
  font-size: 33rpx;
  font-weight: 700;
}

.template-row {
  width: 100%;
  height: 265rpx;
  white-space: nowrap;
}

.template-track {
  display: flex;
  gap: 21rpx;
  width: 865rpx;
  height: 265rpx;
}

.home-card {
  position: relative;
  flex: 0 0 auto;
  width: 200rpx;
  height: 265rpx;
  overflow: hidden;
  border-radius: 35rpx;
  background: var(--bg-surface);
}

.home-card-image {
  display: block;
  width: 200rpx;
  height: 265rpx;
}

.home-card-shade {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 200rpx;
  height: 112rpx;
  border-radius: 0 0 35rpx 35rpx;
  background: linear-gradient(180deg, rgba(17, 24, 39, 0) 0%, rgba(17, 24, 39, 0.73) 100%);
}

.home-card-name {
  position: absolute;
  left: 19rpx;
  bottom: 15rpx;
  width: 162rpx;
  overflow: hidden;
  color: #FFFFFF;
  font-size: 21rpx;
  font-weight: 800;
  line-height: 35rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-empty {
  margin: 0 31rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 265rpx;
  border-radius: 30rpx;
  background: #F8F8FC;
  text-align: center;
}

.home-empty-title,
.home-empty-copy {
  display: block;
}

.home-empty-title {
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 900;
}

.home-empty-copy {
  margin-top: 12rpx;
  color: var(--text-tertiary);
  font-size: 23rpx;
  line-height: 1.45;
}
