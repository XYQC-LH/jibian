.preview-page {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background: #050506;
  font-family: -apple-system, BlinkMacSystemFont, "Noto Sans SC", "Source Han Sans SC", sans-serif;
}

.preview-image {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100vh;
}

.preview-top {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  height: 128rpx;
  padding: 52rpx 24rpx 18rpx;
  opacity: 0;
  transform: translateY(-16rpx);
  transition: opacity 180ms ease-out, transform 180ms ease-out;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.58), rgba(0, 0, 0, 0));
  pointer-events: none;
}

.preview-top-show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.preview-back {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.18);
  font-size: 48rpx;
  line-height: 1;
}

.preview-title {
  flex: 1;
  overflow: hidden;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preview-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  gap: 18rpx;
  box-sizing: border-box;
  padding: 22rpx 36rpx calc(26rpx + env(safe-area-inset-bottom));
  opacity: 0;
  transform: translateY(24rpx);
  transition: opacity 180ms ease-out, transform 180ms ease-out;
  pointer-events: none;
}

.preview-actions-show {
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.preview-action {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  box-sizing: border-box;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  color: var(--text-primary);
  background: rgba(255, 255, 255, 0.92);
  font-size: 27rpx;
  font-weight: 900;
  line-height: 76rpx;
}

.preview-action::after {
  border: 0;
}
