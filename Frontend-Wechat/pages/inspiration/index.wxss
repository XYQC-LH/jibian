.inspiration-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 0 30rpx 180rpx;
  background: #F6F7FB;
  font-family: "Noto Sans SC", "Source Han Sans SC", -apple-system, BlinkMacSystemFont, sans-serif;
}

.inspiration-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 66rpx;
}

.inspiration-title {
  color: #20151D;
  font-size: 54rpx;
  font-weight: 900;
  line-height: 1;
}

.collect-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  color: #8E7F8B;
  font-size: 33rpx;
  line-height: 1;
}

.category-scroll {
  width: 100%;
  margin: 22rpx 0 30rpx;
  white-space: nowrap;
}

.category-track {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 700rpx;
}

.category-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 100rpx;
  height: 62rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  color: #8E7F8B;
  background: #FFFFFF;
  font-size: 25rpx;
  font-weight: 800;
}

.category-chip-active {
  color: #AF52DE;
  background: #F4ECFD;
  border: 2rpx solid #E7D8F8;
}

.inspiration-grid {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
}

.masonry-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  min-width: 0;
}

.inspiration-card {
  width: 100%;
  box-sizing: border-box;
  border-radius: 38rpx;
  background: #FFFFFF;
  box-shadow: 0 6rpx 20rpx rgba(142, 163, 255, 0.09);
  overflow: hidden;
}

.cover-wrap {
  position: relative;
  overflow: hidden;
  border-radius: 34rpx;
  background: #E7E4EF;
}

.cover-image {
  display: block;
  width: 100%;
}

.cover-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 108rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.4));
  border-radius: 0 0 34rpx 34rpx;
  pointer-events: none;
}

.favorite-button {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 999rpx;
  color: #C2C2C7;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(28rpx);
  -webkit-backdrop-filter: blur(28rpx);
}

.favorite-star {
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1;
}

.favorite-button-active {
  color: #FFD84D;
}

.card-name {
  display: block;
  margin: 18rpx 20rpx 0;
  overflow: hidden;
  color: #20151D;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.32;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 20rpx 18rpx;
}

.card-price {
  color: #AF52DE;
  font-size: 21rpx;
  font-weight: 700;
}

.use-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 112rpx;
  height: 54rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  color: #FFFFFF;
  background: linear-gradient(90deg, #FF77B9, #A58CFF);
  font-size: 21rpx;
  font-weight: 800;
}
