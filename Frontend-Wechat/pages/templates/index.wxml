<view class="templates-page safe-bottom">
  <view class="templates-hero">
    <view>
      <text class="templates-kicker">即变风格库</text>
      <text class="templates-title">选一个效果，上传照片开始变</text>
      <text class="templates-copy">选好模板后上传照片，几秒看见新的自己。</text>
    </view>
    <view class="templates-credit" bindtap="goProfile" hover-class="button-pressed">
      <text class="credit-star">✦</text>
      <text class="credit-count">{{creditBalance}}</text>
    </view>
  </view>

  <scroll-view class="templates-category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="templates-category-list">
      <block wx:for="{{categories}}" wx:key="*this">
        <view
          class="templates-category-chip {{activeCategory === item ? 'templates-category-chip-active' : ''}}"
          bindtap="selectCategory"
          data-category="{{item}}"
        >
          {{item}}
        </view>
      </block>
    </view>
  </scroll-view>

  <view class="templates-section-head">
    <text class="templates-section-title">{{activeCategory}}模板</text>
    <text class="templates-section-count">{{templates.length}} 个效果</text>
  </view>

  <view class="templates-grid" wx:if="{{templates.length}}">
    <block wx:for="{{templates}}" wx:key="id">
      <view class="templates-card" hover-class="button-pressed" bindtap="goCreate" data-id="{{item.id}}">
        <image class="templates-cover" src="{{item.cover}}" mode="aspectFill" />
        <view class="templates-card-shade"></view>
        <text class="templates-name">{{item.name}}</text>
        <view class="templates-card-meta">
          <text>{{item.uses}}</text>
          <text>{{item.price}} 积分</text>
        </view>
      </view>
    </block>
  </view>

  <view class="templates-empty" wx:else>
    <text class="templates-empty-title">这个分类还在整理</text>
    <text class="templates-empty-copy">先看看热门效果，下一版会补更多模板。</text>
  </view>

  <bottom-nav active="inspiration"></bottom-nav>
</view>
