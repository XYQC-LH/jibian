.templates-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 24rpx 180rpx;
  background: var(--bg-surface);
  font-family: -apple-system, BlinkMacSystemFont, "Noto Sans SC", "Source Han Sans SC", sans-serif;
}

.templates-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  box-sizing: border-box;
  padding: 28rpx 28rpx 32rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #F8F1FF 52%, #FFF0F4 100%);
}

.templates-kicker,
.templates-title,
.templates-copy {
  display: block;
}

.templates-kicker {
  color: var(--accent-primary);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1.3;
}

.templates-title {
  margin-top: 10rpx;
  color: var(--text-primary);
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.24;
}

.templates-copy {
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: 25rpx;
  line-height: 1.45;
}

.templates-credit {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  gap: 8rpx;
  width: 92rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: var(--accent-soft);
}

.credit-star,
.credit-count {
  color: var(--accent-primary);
  font-size: 23rpx;
  font-weight: 800;
  line-height: 1;
}

.templates-category-scroll {
  width: 100%;
  margin: 28rpx 0 24rpx;
  white-space: nowrap;
}

.templates-category-list {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 920rpx;
}

.templates-category-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-width: 96rpx;
  height: 58rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  color: var(--text-secondary);
  background: rgba(60, 60, 67, 0.08);
  font-size: 25rpx;
  font-weight: 700;
}

.templates-category-chip-active {
  color: var(--accent-primary);
  background: #EDE4F3;
  font-weight: 800;
}

.templates-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 4rpx 20rpx;
}

.templates-section-title {
  color: var(--text-primary);
  font-size: 32rpx;
  font-weight: 900;
}

.templates-section-count {
  color: #9C9CA3;
  font-size: 23rpx;
  font-weight: 700;
}

.templates-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
}

.templates-card {
  position: relative;
  width: calc((100% - 22rpx) / 2);
  height: 282rpx;
  overflow: hidden;
  border-radius: 26rpx;
  background: #FFFFFF;
}

.templates-cover {
  display: block;
  width: 100%;
  height: 100%;
}

.templates-card-shade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: linear-gradient(180deg, rgba(17, 24, 39, 0) 0%, rgba(17, 24, 39, 0.76) 100%);
}

.templates-name {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 50rpx;
  overflow: hidden;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 900;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.templates-card-meta {
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  bottom: 18rpx;
  display: flex;
  justify-content: space-between;
  color: rgba(255, 255, 255, 0.82);
  font-size: 21rpx;
  font-weight: 700;
}

.templates-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 420rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  text-align: center;
}

.templates-empty-title {
  color: var(--text-primary);
  font-size: 30rpx;
  font-weight: 900;
}

.templates-empty-copy {
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: 25rpx;
  line-height: 1.45;
}
