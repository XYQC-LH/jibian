<view class="bottom-nav-shell">
  <view class="bottom-nav-glow"></view>
  <view class="bottom-nav-card">
    <block wx:for="{{tabs}}" wx:key="key">
      <view
        class="bottom-nav-item {{active === item.key ? 'bottom-nav-item-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="handleTap"
        hover-class="bottom-nav-pressed"
      >
        <view class="bottom-nav-active-bg" wx:if="{{active === item.key}}">
          <view class="bottom-nav-active-shine"></view>
        </view>
        <text class="bottom-nav-label">{{item.label}}</text>
      </view>
    </block>
  </view>
</view>
