generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  openid     String   @unique @db.VarChar(128)
  unionid    String?  @db.VarChar(128)
  nickname   String?  @db.VarChar(64)
  avatarUrl  String?  @map("avatar_url") @db.Text
  phone      String?  @db.VarChar(32)
  phoneBound Boolean  @default(false) @map("phone_bound")
  inviteCode String?  @unique @map("invite_code") @db.VarChar(16)
  adminNote  String?  @map("admin_note") @db.Text
  status     String   @default("active") @db.VarChar(32)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  assets                  Asset[]
  tasks                   Task[]
  creditAccount           CreditAccount?
  creditLedger            CreditLedger[]
  paymentOrders           PaymentOrder[]
  membershipSubscriptions MembershipSubscription[]
  membershipOrders        MembershipOrder[]
  userCreations           UserCreation[]
  favorites               Favorite[]
  inviteRelationsSent     InviteRelation[] @relation("InviteRelationInviter")
  inviteRelationReceived  InviteRelation?  @relation("InviteRelationInvitee")

  @@map("users")
}

model AdminUser {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username    String   @unique @db.VarChar(64)
  passwordHash String  @map("password_hash") @db.Text
  envSyncedAt DateTime @map("env_synced_at") @db.Timestamptz

  @@map("admin_users")
}

model Task {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  templateId          String    @map("template_id") @db.Uuid
  inputAssetId        String    @map("input_asset_id") @db.Uuid
  resultAssetId       String?   @map("result_asset_id") @db.Uuid
  idempotencyKey      String?   @map("idempotency_key") @db.VarChar(128)
  ratio               String    @default("1:1") @db.VarChar(16)
  status              String    @default("running") @db.VarChar(32)
  expectedResultCount Int       @default(1) @map("expected_result_count")
  creditCost          Int       @default(0) @map("credit_cost")
  creditStatus        String    @default("charged") @map("credit_status") @db.VarChar(32)
  isVisible           Boolean   @default(false) @map("is_visible")
  adminDeletedAt      DateTime? @map("admin_deleted_at") @db.Timestamptz
  errorMessage        String?   @map("error_message") @db.Text
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  finishedAt          DateTime? @map("finished_at") @db.Timestamptz
  durationMs          Int?      @map("duration_ms")

  user        User          @relation(fields: [userId], references: [id])
  template    Template      @relation(fields: [templateId], references: [id])
  inputAsset  Asset         @relation("TaskInputAsset", fields: [inputAssetId], references: [id])
  resultAsset Asset?        @relation("TaskResultAsset", fields: [resultAssetId], references: [id])
  sourceRuns  SourceRun[]
  creations   UserCreation[]

  @@unique([userId, idempotencyKey])
  @@map("tasks")
}

model SourceRun {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId             String   @map("task_id") @db.Uuid
  sourceId           String   @map("source_id") @db.VarChar(128)
  upstreamJobId      String?  @map("upstream_job_id") @db.VarChar(128)
  status             String   @db.VarChar(32)
  latencyMs          Int?     @map("latency_ms")
  costAmount         Decimal? @map("cost_amount") @db.Decimal(12, 4)
  sourceErrorMessage String?  @map("source_error_message") @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  task Task @relation(fields: [taskId], references: [id])

  @@map("source_runs")
}

model Template {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String @db.VarChar(80)
  category     String @db.VarChar(64)
  coverAssetId String? @map("cover_asset_id") @db.Uuid
  prompt       String @db.Text
  priceCredits Int    @default(0) @map("price_credits")
  resultCount  Int    @default(1) @map("result_count")
  sortOrder    Int    @default(0) @map("sort_order")
  status       String @default("draft") @db.VarChar(32)

  coverAsset Asset? @relation("TemplateCoverAsset", fields: [coverAssetId], references: [id])
  tasks      Task[]
  favorites  Favorite[]

  @@map("templates")
}

model GenerationTimeAnchor {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resultCount           Int      @unique @map("result_count")
  anchorDurationSeconds Decimal  @default(30) @map("anchor_duration_seconds") @db.Decimal(10, 3)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("generation_time_anchors")
}

model Asset {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId String?  @map("owner_user_id") @db.Uuid
  assetType   String   @map("asset_type") @db.VarChar(32)
  storageKey  String   @unique @map("storage_key") @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  ownerUser      User?          @relation(fields: [ownerUserId], references: [id])
  taskInputs     Task[]         @relation("TaskInputAsset")
  taskResults    Task[]         @relation("TaskResultAsset")
  templateCovers Template[]     @relation("TemplateCoverAsset")
  userCreations  UserCreation[]

  @@map("assets")
}

model ReviewRecord {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType  String   @map("target_type") @db.VarChar(64)
  targetId    String   @map("target_id") @db.Uuid
  reviewStage String   @map("review_stage") @db.VarChar(32)
  status      String   @default("pending") @db.VarChar(32)
  policyHit   Json?    @map("policy_hit")
  reason      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("review_records")
}

model CreditAccount {
  userId    String   @id @map("user_id") @db.Uuid
  balance   Int      @default(0)
  updatedAt DateTime @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("credit_accounts")
}

model CreditLedger {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  type         String   @db.VarChar(32)
  amount       Int
  refType      String   @map("ref_type") @db.VarChar(64)
  refId        String   @map("ref_id") @db.Uuid
  balanceAfter Int      @map("balance_after")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@map("credit_ledger")
}

model PaymentOrder {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  provider        String    @default("wechat_pay") @db.VarChar(32)
  packageId       String    @map("package_id") @db.VarChar(64)
  outTradeNo      String    @unique @map("out_trade_no") @db.VarChar(64)
  prepayId        String?   @map("prepay_id") @db.VarChar(128)
  wxTransactionId String?   @map("wx_transaction_id") @db.VarChar(128)
  status          String    @default("pending") @db.VarChar(32)
  amountFen       Int       @map("amount_fen")
  credits         Int
  failureReason   String?   @map("failure_reason") @db.Text
  paidAt          DateTime? @map("paid_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])
  refunds PaymentRefund[]

  @@index([userId, createdAt])
  @@map("payment_orders")
}

model PaymentRefund {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentOrderId String    @map("payment_order_id") @db.Uuid
  outRefundNo   String    @unique @map("out_refund_no") @db.VarChar(64)
  wxRefundId    String?   @map("wx_refund_id") @db.VarChar(128)
  status         String    @default("processing") @db.VarChar(32)
  amountFen      Int       @map("amount_fen")
  credits        Int
  reason         String?   @db.Text
  failureReason  String?   @map("failure_reason") @db.Text
  succeededAt    DateTime? @map("succeeded_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id])

  @@index([paymentOrderId, createdAt])
  @@map("payment_refunds")
}

model MembershipPlan {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String   @unique @db.VarChar(32)
  name       String   @db.VarChar(64)
  amountFen  Int      @map("amount_fen")
  periodDays Int      @map("period_days")
  status     String   @default("active") @db.VarChar(32)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  subscriptions MembershipSubscription[]
  orders        MembershipOrder[]

  @@map("membership_plans")
}

model MembershipSubscription {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  planId             String    @map("plan_id") @db.Uuid
  outContractCode    String    @unique @map("out_contract_code") @db.VarChar(64)
  contractId         String?   @unique @map("contract_id") @db.VarChar(128)
  status             String    @default("pending") @db.VarChar(32)
  currentPeriodStart DateTime? @map("current_period_start") @db.Timestamptz
  currentPeriodEnd   DateTime? @map("current_period_end") @db.Timestamptz
  nextRenewAt        DateTime? @map("next_renew_at") @db.Timestamptz
  cancelAtPeriodEnd  Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt         DateTime? @map("canceled_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user   User              @relation(fields: [userId], references: [id])
  plan   MembershipPlan    @relation(fields: [planId], references: [id])
  orders MembershipOrder[]

  @@index([userId, status])
  @@index([currentPeriodEnd])
  @@index([nextRenewAt])
  @@map("membership_subscriptions")
}

model MembershipOrder {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId  String    @map("subscription_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  planId          String    @map("plan_id") @db.Uuid
  orderType       String    @map("order_type") @db.VarChar(32)
  outTradeNo      String    @unique @map("out_trade_no") @db.VarChar(64)
  wxTransactionId String?   @map("wx_transaction_id") @db.VarChar(128)
  status          String    @default("pending") @db.VarChar(32)
  amountFen       Int       @map("amount_fen")
  periodStart     DateTime  @map("period_start") @db.Timestamptz
  periodEnd       DateTime  @map("period_end") @db.Timestamptz
  failureReason   String?   @map("failure_reason") @db.Text
  paidAt          DateTime? @map("paid_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  subscription MembershipSubscription @relation(fields: [subscriptionId], references: [id])
  user         User                   @relation(fields: [userId], references: [id])
  plan         MembershipPlan         @relation(fields: [planId], references: [id])
  refunds      MembershipRefund[]

  @@index([userId, createdAt])
  @@index([subscriptionId, createdAt])
  @@map("membership_orders")
}

model MembershipRefund {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membershipOrderId String    @map("membership_order_id") @db.Uuid
  outRefundNo       String    @unique @map("out_refund_no") @db.VarChar(64)
  wxRefundId        String?   @map("wx_refund_id") @db.VarChar(128)
  status            String    @default("processing") @db.VarChar(32)
  amountFen         Int       @map("amount_fen")
  reason            String?   @db.Text
  failureReason     String?   @map("failure_reason") @db.Text
  succeededAt       DateTime? @map("succeeded_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  membershipOrder MembershipOrder @relation(fields: [membershipOrderId], references: [id])

  @@index([membershipOrderId, createdAt])
  @@map("membership_refunds")
}

model WechatMembershipEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @unique @map("event_id") @db.VarChar(128)
  eventType   String   @map("event_type") @db.VarChar(64)
  payload     Json
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@map("wechat_membership_events")
}

model RedeemCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String    @unique @db.VarChar(64)
  amount    Int
  status    String    @default("active") @db.VarChar(32)
  maxUses   Int       @default(1) @map("max_uses")
  usedCount Int       @default(0) @map("used_count")
  expiresAt DateTime? @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("redeem_codes")
}

model InviteRelation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inviterId     String    @map("inviter_id") @db.Uuid
  inviteeId     String    @unique @map("invitee_id") @db.Uuid
  status        String    @default("bound") @db.VarChar(32)
  rewardCredits Int       @default(30) @map("reward_credits")
  rewardedAt    DateTime? @map("rewarded_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz

  inviter User @relation("InviteRelationInviter", fields: [inviterId], references: [id])
  invitee User @relation("InviteRelationInvitee", fields: [inviteeId], references: [id])

  @@index([inviterId, status])
  @@map("invite_relations")
}

model Setting {
  key       String   @id @db.VarChar(128)
  value     String   @db.Text
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@map("settings")
}

model UserCreation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  taskId       String   @map("task_id") @db.Uuid
  title        String?  @db.VarChar(120)
  coverAssetId String   @map("cover_asset_id") @db.Uuid
  status       String   @default("active") @db.VarChar(32)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user       User  @relation(fields: [userId], references: [id])
  task       Task  @relation(fields: [taskId], references: [id])
  coverAsset Asset @relation(fields: [coverAssetId], references: [id])

  @@map("user_creations")
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  templateId String   @map("template_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  user     User     @relation(fields: [userId], references: [id])
  template Template @relation(fields: [templateId], references: [id])

  @@unique([userId, templateId])
  @@map("favorites")
}

model TemplateCategory {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(32)
  displayName String   @map("display_name") @db.VarChar(80)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("template_categories")
}
