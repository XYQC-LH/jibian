# Database / Redis / server
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jibian?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=8000

# docker-compose (Backend/.env) requires these; must match DATABASE_URL credentials.
POSTGRES_DB="jibian"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"

# Auth secrets - production MUST use strong random values.
JWT_SECRET="change-me"
ADMIN_SESSION_SECRET="change-admin-session-secret"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me"

# Asset storage public base URL - production MUST be an https domain (CDN/domain pointing to the bucket).
ASSET_PUBLIC_BASE_URL="https://assets.example.com"

# Tencent COS (S3-compatible) storage. Leave empty to keep the mock:// upload URLs (dev only).
# Either set ASSET_STORAGE_SECRET_ACCESS_KEY directly, or set COS_SECRET_REF to the name of
# another environment variable that holds the secret key (never inline the key in this file).
ASSET_STORAGE_BUCKET=""
ASSET_STORAGE_REGION=""
ASSET_STORAGE_ENDPOINT=""
ASSET_STORAGE_ACCESS_KEY_ID=""
ASSET_STORAGE_SECRET_ACCESS_KEY=""
COS_SECRET_REF=""
# COS-native aliases (used when the ASSET_STORAGE_* names above are empty):
COS_BUCKET_PRIVATE=""
COS_REGION=""
COS_ENDPOINT=""
COS_SECRET_ID=""
COS_SECRET_KEY=""
COS_PUBLIC_BASE_URL=""
ASSET_UPLOAD_URL_EXPIRES_SECONDS=900

# WeChat mini program login. Production requires real AppId/AppSecret;
# mock openid login is only allowed when ALLOW_MOCK_WECHAT=true AND NODE_ENV != production.
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
ALLOW_MOCK_WECHAT=false

# Leave real source keys empty to skip them and use the mock fallback.
# ALLOW_MOCK_SOURCE=true only for local development; production must keep it false,
# otherwise a failed real source silently falls back to fake results.
T8_BASE_URL=""
T8_API_KEY=""
GRSAI_API_HOST=""
GRSAI_API_KEY=""
KUAI_BASE_URL="https://api.kuai.host"
KUAI_API_KEY=""
ALLOW_MOCK_SOURCE=false

# Content moderation. Local keyword rules are always on unless MODERATION_ENABLED=false.
# Set MODERATION_API_URL to enable the remote review layer (fail-closed).
MODERATION_ENABLED=true
MODERATION_API_URL=""
MODERATION_API_KEY=""
