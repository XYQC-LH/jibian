# App
APP_ENV=production
APP_NAME=jibian
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=https://api.jibian.art
FRONTEND_ORIGINS=https://jibian.art,https://www.jibian.art
LOG_LEVEL=info

# Database and queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jibian?schema=public
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# WeChat mini program
WECHAT_APP_ID=
WECHAT_APP_SECRET=
ALLOW_MOCK_WECHAT=false

# Tencent COS storage (S3-compatible). Leave empty to use mock:// upload URLs (dev only).
ASSET_PUBLIC_BASE_URL=https://assets.example.com
STORAGE_BACKEND=cos
STORAGE_UPLOAD_EXPIRE_SECONDS=600
COS_REGION=
COS_ENDPOINT=
COS_BUCKET_PRIVATE=
COS_BUCKET_PUBLIC=
COS_PRIVATE_BASE_URL=
COS_SECRET_ID=
COS_SECRET_KEY=

# Aliyun content safety (Green enhanced image moderation)
# Used by ContentModerationService for input/output image review (fail-closed).
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
MODERATION_ALIYUN_REGION=cn-shenzhen
# Optional overrides (defaults used when empty):
# MODERATION_ALIYUN_IMAGE_SERVICE=baselineCheck
# MODERATION_ALIYUN_BLOCK_RISK_LEVELS=high,medium

# Content moderation master switch. false skips all review (still records audit).
MODERATION_ENABLED=true

# Generation sources. Leave keys empty to use the mock fallback (dev only).
T8_BASE_URL=https://ai.t8star.org
T8_API_KEY=
GRSAI_API_HOST=https://grsaiapi.com
GRSAI_API_KEY=
KUAI_BASE_URL=https://api.kuai.host
KUAI_API_KEY=
ALLOW_MOCK_SOURCE=false
